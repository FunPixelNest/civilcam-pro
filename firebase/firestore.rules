rules_version = '2';

// Everything lives under orgs/{org}/...
//   org = the company e-mail domain (e.g. "lnt.com") for company accounts, so engineers of
//         one company share projects, photos and their custom list values;
//   org = "u_<uid>" for personal accounts (gmail.com, outlook.com ...), private to that person.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function trustedProvider() {
      return request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com', 'apple.com'];
    }
    function emailDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }
    function member(org) {
      return signedIn() && (
        org == 'u_' + request.auth.uid ||
        (trustedProvider() && request.auth.token.email != null && emailDomain() == org)
      );
    }

    match /orgs/{org}/{collection}/{doc} {
      allow read, write: if member(org) && collection in ['projects', 'photos', 'options'];
    }

    // Team projects: teams/{projectId} holds the project with members = [lower-case e-mails].
    // Members read and write the project and its photos. Only the owner changes the member list;
    // a member may take only themselves off it (leave the team).
    function myEmail() { return request.auth.token.email.lower(); }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function isMember(pid) {
      return verifiedEmail() && myEmail() in get(/databases/$(database)/documents/teams/$(pid)).data.members;
    }
    match /teams/{pid} {
      allow read: if verifiedEmail() && myEmail() in resource.data.members;
      allow create: if verifiedEmail()
        && request.resource.data.owner == myEmail()
        && request.resource.data.members is list
        && myEmail() in request.resource.data.members
        && request.resource.data.members.size() <= 50;
      allow update: if verifiedEmail()
        && myEmail() in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.members.size() <= 50
        && (resource.data.owner == myEmail()
            || request.resource.data.members == resource.data.members
            || request.resource.data.members == resource.data.members.removeAll([myEmail()]));
      allow delete: if verifiedEmail() && resource.data.owner == myEmail();

      match /photos/{photoId} {
        allow read, write: if isMember(pid);
      }
    }

    // Support & suggestions: anyone signed in can send one; only the team reads them (in the console)
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() < 20000;
    }
  }
}
