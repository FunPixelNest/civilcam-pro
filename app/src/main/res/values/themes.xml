<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme: no action bar, full screen dark -->
    <style name="Theme.CivilCamPro" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash: full screen, no status bar -->
    <style name="Theme.CivilCamPro.Splash" parent="Theme.CivilCamPro">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
